# ---- LLM providers --------------------------------------------------------
# Default provider used when the client does not pick one: "groq" or "openai"
LLM_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.0

# ---- Database ---------------------------------------------------------------
# Leave empty to use the bundled SQLite sample database (data/sample.db),
# which is created automatically on first start.
# Examples:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/shop
#   DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/shop
DATABASE_URL=

# ---- Behaviour --------------------------------------------------------------
# How many times a failing query is sent back to the LLM to be fixed
MAX_RETRIES=3
# Maximum rows returned to the client
MAX_ROWS=500
# Rows per table shown to the LLM as examples (0 to disable)
SAMPLE_ROWS_IN_PROMPT=3
# Ask the LLM to summarise the result as a plain-English answer
GENERATE_ANSWER=true

# ---- API ----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO
